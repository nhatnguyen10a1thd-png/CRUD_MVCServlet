<c:url value="/admin/category/list"
       var="categoryListUrl"/>

<c:url value="/admin/category/add"
       var="categoryAddUrl"/>

<aside class="sidebar">

  <div class="sidebar-title">
    Dashboard
  </div>

  <div class="profile">

    <div class="avatar">
      AD
    </div>

    <div class="profile-name">
      Bạn là Admin
    </div>

  </div>

  <nav class="sidebar-menu">

    <a href="${categoryListUrl}"
       class="menu-item dashboard-item">
      <i class="fas fa-tachometer-alt"></i>
      Dashboard
    </a>

    <div class="menu-item category-title active">
      <i class="fas fa-th-list"></i>
      Quản lý Danh mục
    </div>

    <a href="${categoryAddUrl}"
       class="submenu-item">
      <i class="fas fa-plus"></i> Thêm danh mục mới
    </a>

    <a href="${categoryListUrl}"
       class="submenu-item">
      <i class="fas fa-list"></i> Danh sách danh mục
    </a>

    <div class="menu-item">
      <i class="fas fa-box"></i>
      Quản lý sản phẩm
    </div>

    <div class="menu-item">
      <i class="fas fa-users"></i>
      Quản lý tài khoản
    </div>

  </nav>

</aside>